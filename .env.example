# Copy this file to `.env` and fill in your own values. `.env` is ignored by git.

# --- LLM backbone -------------------------------------------------------------
# Provider: groq (default, free tier available at https://console.groq.com), ollama, anthropic or openai
LLM_PROVIDER=groq
GROQ_API_KEY=

# Models for the three roles. Reviewer A and reviewer B must be different models
# so that dual screening is really independent.
MODEL_PRIMARY=openai/gpt-oss-120b
MODEL_SECONDARY=qwen/qwen3.8-27b
MODEL_FAST=openai/gpt-oss-20b

# Rate limits per model (defaults match the Groq free tier). Raise them on a paid plan.
TOKENS_PER_MINUTE=8000
REQUESTS_PER_MINUTE=30

# --- Embeddings ---------------------------------------------------------------
# fastembed = local ONNX model, no server needed. ollama = uses OLLAMA_EMBEDDING_MODEL.
EMBEDDING_PROVIDER=fastembed
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Literature sources (all optional) ------------------------------------------
# The pipeline works without any of these; they only raise rate limits.
# OPENALEX_API_KEY=
# S2_API_KEY=
# NCBI_API_KEY=
# Your e-mail is sent to PubMed / OpenAlex (polite pool) and Unpaywall ONLY if you set it here.
# CONTACT_EMAIL=

# --- Optional tracing with LangSmith ----------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
